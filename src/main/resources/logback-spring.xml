<configuration>
    <appender name="ROLLING" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <file>C:/Users/USER/Documents/Code/PetHub - backend/log/booking.log</file>

        <rollingPolicy class="ch.qos.logback.core.rolling.TimeBasedRollingPolicy">
            <!-- Daily log file with date in the name -->
            <fileNamePattern>
                C:/Users/USER/Documents/Code/PetHub - backend/log/booking-%d{yyyy-MM-dd}.log
            </fileNamePattern>

            <!-- Keep 30 days of history -->
            <maxHistory>30</maxHistory>
        </rollingPolicy>

        <encoder>
            <pattern>%d{yyyy-MM-dd HH:mm:ss} [%thread] %-5level %logger{36} - %msg%n</pattern>
        </encoder>
    </appender>

    <root level="INFO">
        <appender-ref ref="ROLLING" />
    </root>
</configuration>